# Unified local environment example for ZenithCRM
# Apply values to:
# - server/.env
# - client/.env (frontend)
# - ai_system/.env

# --- Backend (server) ---
DATABASE_URL=postgresql://sigorta_admin:sigorta_2024_secure_pass@localhost:5433/sigorta_crm?schema=public
DIRECT_URL=postgresql://sigorta_admin:sigorta_2024_secure_pass@localhost:5433/sigorta_crm?schema=public
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN_SHORT=7d
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
GOOGLE_AI_API_KEY=your-google-ai-api-key
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Frontend (client) ---
VITE_API_URL=http://localhost:3000

# --- AI System (ai_system) ---
AI_DATABASE_URL=postgresql://sigorta_admin:sigorta_2024_secure_pass@localhost:5433/sigorta_crm?schema=public
GCS_BUCKET=your-gcs-bucket-name
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\service-account.json
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_FLASH_MODEL=gemini-1.5-flash
EMBEDDING_DIMENSION=768
MAX_CHUNK_CHARS=2000
MAX_CONTEXT_CHUNKS=6
