generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  logo            String?
  plan            String           @default("FREE")
  isActive        Boolean          @default(true)
  isSingleBranch  Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  branches        Branch[]
  customers       Customer[]
  sales           Sale[]
  policyTypes     PolicyType[]
  commissionRules CommissionRule[]
  tasks           Task[]
  salesTargets    SalesTarget[]
  auditLogs       AuditLog[]
  commissionLogs  CommissionLog[]
  messages        Message[]
  notifications   Notification[]
  documents       Document[]
  supportMessages SupportMessage[]

  @@map("tenants")
}

model User {
  id                  String          @id @default(uuid())
  email               String          @unique
  identityNumber      String?         @unique
  password            String
  name                String
  role                Role            @default(EMPLOYEE)
  tenantId            String
  branchId            String?
  isActive            Boolean         @default(true)
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  failedLoginAttempts Int             @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  auditLogs           AuditLog[]
  commissionLogs      CommissionLog[]
  receivedMessages    Message[]       @relation("ReceivedMessages")
  sentMessages        Message[]       @relation("SentMessages")
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  sales               Sale[]
  tasks               Task[]
  salesTargets        SalesTarget[]
  supportMessages     SupportMessage[]
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch              Branch?         @relation(fields: [branchId], references: [id])

  @@index([email])
  @@index([tenantId])
  @@index([branchId])
  @@map("users")
}

model Document {
  id         String    @id @default(uuid())
  filename   String
  path       String
  mimetype   String
  size       Int
  storageProvider String?
  storageKey String?
  accountCode String?
  accountTitle String?
  accountConfidence String?
  saleId     String?
  tenantId   String
  uploadedAt DateTime  @default(now())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  sale       Sale?     @relation(fields: [saleId], references: [id])
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("documents")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Branch {
  id              String           @id @default(uuid())
  name            String
  tenantId        String
  settings        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commissionRules CommissionRule[]
  messages        Message[]
  sales           Sale[]
  users           User[]
  salesTargets    SalesTarget[]

  @@index([tenantId])
  @@map("branches")
}

model Customer {
  id          String     @id @default(uuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  identityNo  String?
  naceCode    String?
  birthDate   DateTime?
  gender      String?
  address     String?
  notes       String?
  tenantId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents   Document[]
  sales       Sale[]
  tasks       Task[]

  @@index([tenantId])
  @@index([email])
  @@index([phone])
  @@index([identityNo])
  @@index([naceCode])
  @@map("customers")
}

model PolicyType {
  id              String           @id @default(uuid())
  name            String
  tenantId        String
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commissionRules CommissionRule[]
  sales           Sale[]
  tasks           Task[]

  @@index([tenantId])
  @@map("policy_types")
}

model Sale {
  id             String          @id @default(uuid())
  policyNumber   String?
  amount         Decimal         @db.Decimal(12, 2)
  status         SaleStatus      @default(LEAD)
  customerId     String?
  branchId       String
  employeeId     String
  policyTypeId   String
  tenantId       String
  saleDate       DateTime?
  startDate      DateTime?
  endDate        DateTime?
  cancelReason   String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  branch         Branch          @relation(fields: [branchId], references: [id])
  customer       Customer?       @relation(fields: [customerId], references: [id])
  employee       User            @relation(fields: [employeeId], references: [id])
  policyType     PolicyType      @relation(fields: [policyTypeId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commissionLogs CommissionLog[]
  documents      Document[]
  messages       Message[]

  @@unique([tenantId, policyNumber])
  @@index([branchId])
  @@index([employeeId])
  @@index([policyTypeId])
  @@index([tenantId])
  @@index([status])
  @@index([saleDate])
  @@index([tenantId, status])
  @@index([tenantId, saleDate])
  @@index([tenantId, branchId])
  @@map("sales")
}

model Task {
  id           String   @id @default(uuid())
  title        String
  description  String?
  dueDate      DateTime
  isCompleted  Boolean  @default(false)
  priority     Priority @default(MEDIUM)
  assignedToId String
  tenantId     String
  customerId   String?
  policyTypeId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignedTo   User     @relation(fields: [assignedToId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  policyType   PolicyType? @relation(fields: [policyTypeId], references: [id])

  @@index([assignedToId])
  @@index([tenantId])
  @@index([dueDate])
  @@index([isCompleted])
  @@index([tenantId, isCompleted, assignedToId])
  @@map("tasks")
}

model CommissionRule {
  id           String      @id @default(uuid())
  name         String
  description  String?
  tenantId     String
  branchId     String?
  policyTypeId String?
  conditions   Json
  formula      String
  validFrom    DateTime
  validTo      DateTime?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  policyType   PolicyType? @relation(fields: [policyTypeId], references: [id], onDelete: Cascade)
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([policyTypeId])
  @@index([tenantId])
  @@index([isActive])
  @@map("commission_rules")
}

model CommissionLog {
  id         String   @id @default(uuid())
  amount     Decimal  @db.Decimal(12, 2)
  isPaid     Boolean  @default(false)
  paidAt     DateTime?
  saleId     String
  employeeId String
  tenantId   String
  createdAt  DateTime @default(now())
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([employeeId])
  @@index([tenantId])
  @@index([isPaid])
  @@index([tenantId, createdAt])
  @@map("commission_logs")
}

model Message {
  id           String    @id @default(uuid())
  subject      String
  content      String
  senderId     String
  receiverId   String
  tenantId     String
  branchId     String?
  saleId       String?
  isRead       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  sender       User      @relation("SentMessages", fields: [senderId], references: [id])
  receiver     User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?   @relation(fields: [branchId], references: [id])
  sale         Sale?     @relation(fields: [saleId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([tenantId])
  @@map("messages")
}



model AuditLog {
  id         String   @id @default(uuid())
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  userId     String?
  tenantId   String
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model SalesTarget {
  id          String   @id @default(uuid())
  userId      String
  branchId    String
  tenantId    String
  period      String
  amount      Decimal  @db.Decimal(12, 2)
  achieved    Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([branchId])
  @@index([tenantId])
  @@map("sales_targets")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum SaleStatus {
  LEAD
  OFFER
  ACTIVE
  CANCELLED
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Notification {
  id          String               @id @default(uuid())
  tenantId    String
  userId      String?
  type        NotificationType
  title       String
  message     String
  link        String?
  isRead      Boolean              @default(false)
  priority    NotificationPriority @default(NORMAL)
  relatedId   String?
  relatedType String?
  createdAt   DateTime             @default(now())
  expiresAt   DateTime?
  user        User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  POLICY_RENEWAL
  TASK_DEADLINE
  TASK_ASSIGNED
  SYSTEM_ALERT
  COMMISSION_EARNED
  CUSTOMER_BIRTHDAY
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model SupportMessage {
  id          String        @id @default(uuid())
  userId      String
  tenantId    String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     String        @db.Text
  response    String?       @db.Text
  status      SupportStatus @default(PENDING)
  aiProcessed Boolean       @default(false)
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([status])
  @@map("support_messages")
}

enum SupportStatus {
  PENDING
  PROCESSING
  RESOLVED
  FAILED
}
